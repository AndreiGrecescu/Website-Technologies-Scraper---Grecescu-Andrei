    "js": { "ShopifyAnalytics": "", "ShopifyAnalytics.meta": "" },
    "xhr": ["monorail-edge\\.shopifysvc\\.com"],
    "scripts": ["window\\.ShopifyAnalytics\\s*=", "trekkie\\.(?:storefront|load)"],
    "requires": ["Shopify"]
  },
  "Shopify Web Pixels Manager": {
    "cats": [42],
